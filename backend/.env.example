# Template for backend/.env. Copy this file to .env and fill in real values.
# This file is committed. Never put real secrets in it.

# Application
APP_ENV=development

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed to call the API, comma-separated.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Database (SQLite file for local development)
DATABASE_URL=sqlite:///./intentune.db

# External services (uncomment when those features are built)
# YOUTUBE_API_KEY=
