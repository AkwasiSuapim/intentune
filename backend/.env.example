# Template for backend/.env. Copy this file to .env and fill in real values.
# This file is committed. Never put real secrets in it.

# Application
APP_ENV=development

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed to call the API, comma-separated.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Database (SQLite file for local development). Intentune resolves a
# relative path against backend/, whatever the working directory, so this is
# backend/data/intentune.db -- also the default when DATABASE_URL is unset.
# Only SQLite is supported.
DATABASE_URL=sqlite:///./data/intentune.db

# Managed media: Intentune's own copies of imported audio. Optional; a relative
# path is resolved against backend/. Unset means backend/data/media.
# MEDIA_ROOT=./data/media

# Nothing loads this file automatically: `python -m src.intentune.api` reads
# these settings from the process environment only. A tool that loads it (for
# example `uvicorn --env-file .env`) applies whatever your .env holds, so check
# its DATABASE_URL first. APP_ENV is not read by anything yet.

# External services (uncomment when those features are built)
# YOUTUBE_API_KEY=
